# コピーして .env を作成し、値を設定してください。.env はコミットしないこと。

# 公開ドメイン（Caddy が HTTPS 証明書を自動取得）。ローカル確認は localhost
SITE_ADDRESS=festival.example.com
PUBLIC_BASE_URL=https://festival.example.com
COOKIE_SECURE=true

# DB
POSTGRES_DB=gakusai
POSTGRES_USER=gakusai
POSTGRES_PASSWORD=change-me-long-random

# トークン導出・現地コード用の秘密鍵（32文字以上のランダム値。変更すると発行済みQRが無効になる）
# 生成例: openssl rand -base64 48
APP_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# 初回起動時のみ作成される管理者（作成後はこの2行を消して構いません）
BOOTSTRAP_ADMIN_LOGIN=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

SESSION_TTL=18h

# アプリ（WebView以外）から別オリジンで呼ぶ場合のみ。通常は空
ALLOWED_ORIGINS=

# Apple Wallet（未設定なら Wallet ボタンは表示されず、Web QR で入場）
WALLET_PASS_TYPE_ID=
WALLET_TEAM_ID=
WALLET_ORG_NAME=天文学研究部
WALLET_VENUE_NAME=プラネタリウム会場
# secrets/wallet/ に置いたファイルをコンテナ内パスで指定
WALLET_CERT_PATH=
WALLET_KEY_PATH=
WALLET_WWDR_PATH=
